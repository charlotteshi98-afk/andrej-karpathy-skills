{
  "manifest_version": 3,
  "name": "VO Script Summary Tool",
  "version": "1.0.0",
  "description": "Game localization VO script analyzer for production teams",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://api.anthropic.com/*", "https://docs.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": { "48": "icon.png" }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": { "48": "icon.png" }
}
